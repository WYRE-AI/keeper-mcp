# keeper-mcp is an HTTP bridge. The calling org's Keeper device config
# arrives on each /mcp request as X-Keeper-Config-Base64. Do not put
# KSM_CONFIG_BASE64 in this file or in the gateway Compose service — that
# would install one static credential for every tenant.

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, your-s2s-secret, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST is ignored.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when CONDUIT_S2S_SECRET is a real secret. Unset keeps 0.0.0.0,
# the historical container bind. The image and Compose set 0.0.0.0 inside
# the container and publish the host port on 127.0.0.1. The insecure-dev
# bypass ignores this and binds 127.0.0.1 only.
# MCP_HTTP_HOST=0.0.0.0

PORT=8080
# MCP_HTTP_PORT=8080
